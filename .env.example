# Template for .env - copy to .env and fill in secrets.
# Start the database first:  docker compose up -d

# --- Database (Docker: pgvector/pgvector:pg17 on host port 5433) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/finspring

# Read-only role used by the SQL template executor (created in db/schema.sql).
# DATABASE_URL_READONLY=postgresql+psycopg://chatbot_readonly:<password>@localhost:5433/finspring

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- LangSmith tracing (Stage 6; optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=finspring-chatbot-v1
