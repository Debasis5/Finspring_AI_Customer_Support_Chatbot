# Template for .env - copy to .env and fill in secrets.
# Start the database first:  docker compose up -d

# --- Database (Docker: pgvector/pgvector:pg17 on host port 5433) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/finspring

# Read-only role used by the SQL template executor (created in db/schema.sql).
# DATABASE_URL_READONLY=postgresql+psycopg://chatbot_readonly:<password>@localhost:5433/finspring

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Optional overrides (defaults in app/config/settings.py) ---
# Model tiering — configured ONLY in settings.py / here (invariant I-9).
# CHEAP_MODEL=gpt-4o-mini          # classify, verify, SQL template selection
# STRONG_MODEL=gpt-4o              # generate only
#
# Ingestion params are frozen in notebooks/experiments/1_4_ingestion.ipynb.
# Changing these invalidates the vector store — re-run ingestion after.
# EMBEDDING_MODEL=text-embedding-3-small
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=4
#
# MAX_RETRIES=2                    # shared generate-retry budget
# MAX_INPUT_LENGTH=2000            # pre_checks rejection threshold
# ENABLE_MODERATION=false          # optional OpenAI moderation in pre_checks

# --- LangSmith tracing (Stage 6; optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=finspring-chatbot-v1
